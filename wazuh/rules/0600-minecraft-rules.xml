<group name="local,minecraft,paper,">

  <rule id="100700" level="3">
    <decoded_as>minecraft-paper-prelogin-disconnect</decoded_as>
    <description>Minecraft Paper pre-login connection ended for $(srcuser) from $(srcip): $(minecraft_reason)</description>
    <group>minecraft,paper,connection_attempt,minecraft_prelogin_disconnect,</group>
  </rule>

  <rule id="100701" level="5">
    <if_sid>100700</if_sid>
    <field name="minecraft_reason" type="pcre2">^You are not whitelisted on this server!$</field>
    <description>Minecraft Paper rejected non-whitelisted player $(srcuser) from $(srcip)</description>
    <group>minecraft,paper,authentication_failed,minecraft_prelogin_disconnect,</group>
  </rule>

  <!-- Authentication-service outages are operational failures, not bot detections. -->
  <rule id="100702" level="8">
    <if_sid>100700</if_sid>
    <field name="minecraft_reason" type="pcre2">^Authentication servers are down\.</field>
    <description>Minecraft Paper could not reach the authentication service</description>
    <group>minecraft,paper,availability,</group>
  </rule>

  <!-- Detect a distributed low-rate spray without requiring one source IP. -->
  <rule id="100710" level="10" frequency="5" timeframe="3600">
    <if_matched_group>minecraft_prelogin_disconnect</if_matched_group>
    <description>Distributed Minecraft Paper pre-login spray detected</description>
    <group>minecraft,paper,authentication_failed,scanner,minecraft_prelogin_disconnect,</group>
  </rule>

  <!-- A single source rotating player names is stronger evidence of automation. -->
  <rule id="100711" level="12" frequency="3" timeframe="3600">
    <if_matched_group>minecraft_prelogin_disconnect</if_matched_group>
    <same_srcip/>
    <different_srcuser/>
    <description>Minecraft Paper source $(srcip) attempted multiple player names</description>
    <group>minecraft,paper,authentication_failed,bruteforce,minecraft_prelogin_disconnect,</group>
  </rule>

  <rule id="100720" level="3">
    <decoded_as>minecraft-paper-login-success</decoded_as>
    <description>Minecraft Paper player $(srcuser) logged in from $(srcip)</description>
    <group>minecraft,paper,authentication_success,</group>
  </rule>

</group>
