<group name="local,ugreen,">

  <rule id="100600" level="3">
    <decoded_as>ugreen-web-login-success</decoded_as>
    <description>UGREEN UGOS web login succeeded</description>
    <group>ugreen,ugos,authentication_success,</group>
  </rule>

  <rule id="100601" level="5">
    <decoded_as>ugreen-web-login-failure</decoded_as>
    <description>UGREEN UGOS web login failed</description>
    <group>ugreen,ugos,authentication_failed,ugreen_web_login_failure,</group>
  </rule>

  <rule id="100610" level="12" frequency="5" timeframe="300">
    <if_matched_group>ugreen_web_login_failure</if_matched_group>
    <same_srcip/>
    <description>UGREEN UGOS repeated web login failures from the same source</description>
    <group>ugreen,ugos,authentication_failed,bruteforce,</group>
  </rule>

  <!-- The failure event has no reliable username, so this correlation is IP-only. -->
  <rule id="100611" level="10" frequency="2" timeframe="300">
    <if_sid>100600</if_sid>
    <if_matched_group>ugreen_web_login_failure</if_matched_group>
    <same_srcip/>
    <description>UGREEN UGOS web login succeeded after a failure from the same source</description>
    <group>ugreen,ugos,authentication_success,correlation,</group>
  </rule>

  <!-- UGOS updates legitimately rotate root credentials; retain this at level 5. -->
  <rule id="100620" level="5">
    <if_sid>5555</if_sid>
    <location>^/var/log/ugreen.log$</location>
    <match>password changed for root</match>
    <description>UGREEN system root password changed</description>
    <group>ugreen,account_change,</group>
  </rule>

  <rule id="100630" level="10">
    <decoded_as>ugreen-storage-io</decoded_as>
    <description>UGREEN storage I/O error on device $(storage_device)</description>
    <group>ugreen,storage,io_error,ugreen_storage_io_error,</group>
  </rule>

  <rule id="100631" level="13" frequency="3" timeframe="300">
    <if_matched_group>ugreen_storage_io_error</if_matched_group>
    <same_field>storage_device</same_field>
    <description>Repeated UGREEN storage I/O errors on device $(storage_device)</description>
    <group>ugreen,storage,io_error,repeated,</group>
  </rule>

</group>
