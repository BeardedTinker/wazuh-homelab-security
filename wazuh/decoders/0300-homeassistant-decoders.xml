<!-- Home Assistant ban (components.http.ban) -->
<decoder name="homeassistant-http-ban">
  <program_name>homeassistant</program_name>
  <prematch>homeassistant.components.http.ban</prematch>
  <regex type="pcre2">invalid authentication from [^()]+\(([0-9]{1,3}(?:\.[0-9]{1,3}){3})\)</regex>
  <order>srcip</order>
</decoder>

<!-- Home Assistant auth failures (explicit string, not "any http") -->
<decoder name="homeassistant-auth-failed">
  <program_name>homeassistant</program_name>
  <prematch>Login attempt or request with invalid authentication</prematch>
  <regex type="pcre2">invalid authentication from [^()]+\(([0-9]{1,3}(?:\.[0-9]{1,3}){3})\)</regex>
  <order>srcip</order>
</decoder>
